<Window x:Class="NetworkHelper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Network Helper" Width="1280" Height="820" MinWidth="1050" MinHeight="680" Background="{StaticResource WindowBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#0D1524" BorderBrush="#233047" BorderThickness="0,0,0,1"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="8" Background="#4F8CFF"><TextBlock Text="N" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0"><TextBlock Text="Network Helper" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Local infrastructure inventory" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#173B35" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="●  LOCAL ONLY" Foreground="#72E0C0" FontSize="11" FontWeight="SemiBold"/></Border></Grid></Border>
  <Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="175"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="2,0,2,8"><TextBlock Text="COMPANIES" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="＋ Add" ToolTip="Add company" Click="AddCompany_Click" Padding="10,5"/></DockPanel>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="CompaniesList" DisplayMemberPath="Name" SelectionChanged="CompaniesList_SelectionChanged"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButton}" Content="Rename" Click="EditCompany_Click" Padding="10,5"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteCompany_Click" Padding="10,5"/></StackPanel></Grid>
    <DockPanel Grid.Row="2" Margin="2,16,2,8"><TextBlock Text="SITES" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="＋ Add" Click="AddSite_Click" Padding="10,5"/></DockPanel>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="SitesList" DisplayMemberPath="Name" SelectionChanged="SitesList_SelectionChanged"/><StackPanel Grid.Row="1" Margin="0,8,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Merge selected site" Click="MergeSite_Click" HorizontalAlignment="Stretch"/><Button Style="{StaticResource SecondaryButton}" Content="Import company data" Click="Upload_Click" HorizontalAlignment="Stretch"/></StackPanel></Grid>
   </Grid></Border>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="2,0,2,15"><StackPanel><TextBlock x:Name="SiteTitle" Text="Select a company" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="SiteSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButton}" Content="Edit" Click="Edit_Click"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="Delete_Click"/></StackPanel></DockPanel>
    <TabControl Grid.Row="1" x:Name="Tabs">
     <TabItem Header="Overview"><Grid Margin="8,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="3" Margin="0,0,0,14"><Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="4" Padding="18"><StackPanel><TextBlock Text="DEVICES" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="DeviceCountText" Text="0" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="4" Padding="18"><StackPanel><TextBlock Text="NETWORKS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="NetworkCountText" Text="0" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="4" Padding="18"><StackPanel><TextBlock Text="UNRESOLVED CONFLICTS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ConflictCountText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#FFB4AC"/></StackPanel></Border></UniformGrid><Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="18"><TextBlock x:Name="OverviewText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border></Grid></TabItem>
     <TabItem Header="Devices"><Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="＋ Add device" Click="AddDevice_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Edit" Click="EditDevice_Click"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteDevice_Click"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Search" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="DeviceSearchBox" Width="190" TextChanged="DeviceFilter_Changed" ToolTip="Name, IP, vendor, model or description"/><ComboBox x:Name="DeviceTypeFilter" Width="145" SelectionChanged="DeviceFilter_Changed"/><ComboBox x:Name="DeviceZoneFilter" Width="110" SelectionChanged="DeviceFilter_Changed"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="DevicesGrid" IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False" SelectionChanged="DevicesGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="*"/><DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="80"/><DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*"/><DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
     <TabItem Header="Networks"><Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="＋ Add network" Click="AddNetwork_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Edit" Click="EditNetwork_Click"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteNetwork_Click"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Search" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="NetworkSearchBox" Width="270" TextChanged="NetworkFilter_Changed" ToolTip="Name, CIDR or VLAN"/><ComboBox x:Name="NetworkZoneFilter" Width="140" SelectionChanged="NetworkFilter_Changed"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="NetworksGrid" IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Network" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="CIDR" Binding="{Binding Cidr}" Width="2*"/><DataGridTextColumn Header="VLAN" Binding="{Binding VlanId}" Width="100"/><DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
     <TabItem Header="Data Sources"><Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button Content="Upload CSV / XLSX / VSDX" Click="Upload_Click"/><Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" Content="Import selected items" IsEnabled="False" Click="Import_Click"/></StackPanel><TextBlock x:Name="ImportStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/></DockPanel><TabControl Grid.Row="1"><TabItem Header="Preview"><DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem><TabItem Header="Imported files"><DataGrid x:Name="SourcesGrid" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem></TabControl></Grid></TabItem>
     <TabItem Header="Relationships &amp; Paths"><Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Infer relationships" Click="InferRelationships_Click"/><Button Style="{StaticResource SecondaryButton}" Content="＋ Add relationship" Click="AddRelationship_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Confirm" ToolTip="Confirm selected relationship" Click="ConfirmRelationship_Click"/><Button Style="{StaticResource DangerButton}" Content="Supersede" ToolTip="Supersede selected relationship" Click="SupersedeRelationship_Click"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Device" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="RelationshipDeviceBox" Width="250" DisplayMemberPath="Name" SelectionChanged="RelationshipDevice_Changed"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="RelationshipsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Relationship" Binding="{Binding Summary}" Width="3*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence,StringFormat=P0}" Width="90"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Evidence / basis" Binding="{Binding Basis}" Width="2*"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="7" Padding="8" Margin="0,10"><DockPanel><Button DockPanel.Dock="Right" Content="Find access path" Click="FindPath_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="Start" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBox x:Name="PathStartBox" Text="Current workstation" Width="180"/><TextBlock Text="Temporarily exclude" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBox x:Name="UnavailableNodesBox" Width="220" ToolTip="Comma-separated node names, e.g. Jump01"/></StackPanel></DockPanel></Border><ListBox Grid.Row="3" x:Name="PathResultsList" DisplayMemberPath="Display"/></Grid></TabItem>
     <TabItem Header="Conflicts"><Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="ConflictsGrid" IsReadOnly="True" AutoGenerateColumns="True" SelectionMode="Single"/><Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="8" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="Keep existing" Click="Keep_Click"/><Button Content="Accept new" Click="Accept_Click"/><TextBox x:Name="ManualValue" Width="210" ToolTip="Correct value"/><Button Style="{StaticResource SecondaryButton}" Content="Use manual value" Click="Manual_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Separate device" Click="Separate_Click"/></StackPanel></Border></Grid></TabItem>
     <TabItem Header="Topology">
      <Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Start firewall" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="TopologyRootBox" DisplayMemberPath="Name"/><TextBlock Grid.Column="3" Text="End device" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><ComboBox Grid.Column="4" x:Name="TopologyTargetBox" DisplayMemberPath="Name" ToolTip="Optional; click a topology node to select it"/><StackPanel Grid.Column="6" Orientation="Horizontal"><CheckBox x:Name="TopologyOnlyPathCheck" Content="Selected path only" VerticalAlignment="Center" Checked="TopologyOption_Changed" Unchecked="TopologyOption_Changed"/><Button Style="{StaticResource SecondaryButton}" Content="Clear end" Click="ClearTopologyTarget_Click"/><Button Content="Build topology" Click="BuildTopology_Click"/></StackPanel></Grid></Border>
       <DockPanel Grid.Row="1" Margin="4,9"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="−" ToolTip="Zoom out" Click="TopologyZoomOut_Click"/><Button Style="{StaticResource SecondaryButton}" Content="100%" ToolTip="Reset zoom" Click="TopologyZoomReset_Click"/><Button Style="{StaticResource SecondaryButton}" Content="＋" ToolTip="Zoom in" Click="TopologyZoomIn_Click"/></StackPanel><TextBlock x:Name="TopologySummaryText" Text="Select a site and firewall, then build the topology." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
       <Border Grid.Row="2" Background="#0B1321" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><ScrollViewer x:Name="TopologyScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="TopologyCanvas" Width="600" Height="400" Background="#0B1321"><Canvas.LayoutTransform><ScaleTransform x:Name="TopologyScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform></Canvas></ScrollViewer></Border>
      </Grid>
     </TabItem>
     <TabItem Header="Troubleshoot">
      <Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="TroubleTargetBox" Width="235" DisplayMemberPath="Name" ToolTip="Optional target device"/><Button Content="Analyse locally" Click="AnalyzeTrouble_Click"/></StackPanel><StackPanel><TextBlock Text="WHAT'S HAPPENING?" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Describe the symptom as you would to another network engineer." FontSize="15" Margin="0,3,0,0"/></StackPanel></DockPanel><TextBox x:Name="TroubleReportBox" Grid.Row="1" Height="78" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Example: AUPIPRDWINVH01 is showing offline in RMM since this morning"/></Grid></Border>
       <Border Grid.Row="1" Background="#10243A" BorderBrush="#244B82" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,10"><StackPanel><TextBlock Text="LOCAL REASONING SUMMARY" Foreground="#76A7FF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="TroubleSummaryText" Text="No investigation started. Network Helper will use only the selected site's stored inventory, evidence and relationships." TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
       <TabControl Grid.Row="2" Margin="0,2,0,0">
        <TabItem Header="Investigation plan"><Grid Margin="4,8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="TroubleStepsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Order}" Width="42"/><DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="150"/><DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="2*"/><DataGridTextColumn Header="Command (not executed)" Binding="{Binding Command}" Width="2*"/><DataGridTextColumn Header="Why / evidence" Binding="{Binding Evidence}" Width="2*"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence,StringFormat=P0}" Width="86"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="Commands are suggestions only. Nothing is executed and no credentials are stored." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="Pending" Click="TroublePending_Click"/><Button Content="Completed" Click="TroubleCompleted_Click"/><Button Style="{StaticResource DangerButton}" Content="Failed" Click="TroubleFailed_Click"/></StackPanel></DockPanel></Grid></TabItem>
        <TabItem Header="Device traversal"><Grid Margin="4,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="TraversalSummaryText" Text="Run an investigation to build the device, host, switch and management traversal." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,4,8"/><DataGrid Grid.Row="1" x:Name="TroubleTraversalGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38"/><DataGridTextColumn Header="From" Binding="{Binding From}" Width="*"/><DataGridTextColumn Header="Relationship" Binding="{Binding Relationship}" Width="125"/><DataGridTextColumn Header="To / next boundary" Binding="{Binding To}" Width="*"/><DataGridTextColumn Header="What to verify" Binding="{Binding Guidance}" Width="3*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence,StringFormat=P0}" Width="82"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="7" Padding="9" Margin="0,8,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="Exclude selected hop" Click="ExcludeTraversalHop_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Reset exclusions" Click="ResetTraversal_Click"/></StackPanel><TextBlock x:Name="TraversalAccessPathText" Text="No workstation access path calculated." TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border></Grid></TabItem>
        <TabItem Header="Previous sessions"><DataGrid x:Name="TroubleSessionsGrid" Margin="4,8" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="TroubleSession_Changed"><DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="170"/><DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="150"/><DataGridTextColumn Header="Issue" Binding="{Binding IssueType}" Width="160"/><DataGridTextColumn Header="Report" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="Command memory"><Grid Margin="4,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="CommandSearchBox" Width="210" TextChanged="CommandSearch_Changed" ToolTip="Search platform, category, command or purpose"/><Button Content="＋ Add" Click="AddCommand_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Edit" Click="EditCommand_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Copy" Click="CopyCommand_Click"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteCommand_Click"/></StackPanel><TextBlock Text="Local command knowledge with purpose and safety classification." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" x:Name="CommandMemoryGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="130"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Command" Binding="{Binding CommandText}" Width="2*"/><DataGridTextColumn Header="Used for" Binding="{Binding Purpose}" Width="2*"/><DataGridTextColumn Header="Safety" Binding="{Binding RiskLevel}" Width="95"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
       </TabControl>
      </Grid>
     </TabItem>
    </TabControl>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
