<Window x:Class="NetworkHelper.Dialogs.RelationshipDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add relationship" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PanelBrush}">
 <Grid Margin="20" MinWidth="500"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="From entity" VerticalAlignment="Center"/><TextBox x:Name="FromBox" Grid.Column="1"/><TextBlock Grid.Row="1" Text="Relationship" VerticalAlignment="Center"/><ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="To entity" VerticalAlignment="Center"/><TextBox x:Name="ToBox" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="Interface / context" VerticalAlignment="Center"/><TextBox x:Name="ScopeBox" Grid.Row="3" Grid.Column="1" ToolTip="Optional. Reuse a port or context name to identify contradictory targets."/><TextBlock Grid.Row="4" Text="Evidence note" VerticalAlignment="Center"/><TextBox x:Name="BasisBox" Grid.Row="4" Grid.Column="1"/><StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True"/><Button Content="Add relationship" IsDefault="True" Click="Save_Click"/></StackPanel></Grid>
