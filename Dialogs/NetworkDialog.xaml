<Window x:Class="NetworkHelper.Dialogs.NetworkDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Network details" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PanelBrush}">
 <Grid Margin="18" MinWidth="400"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Name *" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1"/><TextBlock Grid.Row="1" Text="CIDR *" VerticalAlignment="Center"/><TextBox x:Name="CidrBox" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="VLAN ID" VerticalAlignment="Center"/><TextBox x:Name="VlanBox" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="Zone" VerticalAlignment="Center"/><ComboBox x:Name="ZoneBox" Grid.Row="3" Grid.Column="1" Margin="3"/><StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True"/><Button Content="Save" IsDefault="True" Click="Save_Click"/></StackPanel></Grid>
</Window>
