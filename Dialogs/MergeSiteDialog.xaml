<Window x:Class="NetworkHelper.Dialogs.MergeSiteDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Merge site" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PanelBrush}">
  <StackPanel Margin="18" MinWidth="380"><TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Keep this destination site:"/><ComboBox x:Name="Targets" DisplayMemberPath="Name" Margin="0,5"/><TextBlock Text="The selected source site will be removed after its data and evidence are transferred." TextWrapping="Wrap" Foreground="#667085" Margin="0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Merge" IsDefault="True" Click="Merge_Click"/></StackPanel></StackPanel>
</Window>
