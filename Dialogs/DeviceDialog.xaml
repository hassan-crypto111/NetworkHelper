<Window x:Class="NetworkHelper.Dialogs.DeviceDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Device details" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PanelBrush}">
 <Grid Margin="18" MinWidth="440"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="Name *" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1"/>
  <TextBlock Grid.Row="1" Text="IP address" VerticalAlignment="Center"/><TextBox x:Name="IpBox" Grid.Row="1" Grid.Column="1"/>
  <TextBlock Grid.Row="2" Text="Type / role" VerticalAlignment="Center"/><TextBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1"/>
  <TextBlock Grid.Row="3" Text="Zone" VerticalAlignment="Center"/><ComboBox x:Name="ZoneBox" Grid.Row="3" Grid.Column="1" Margin="3"/>
  <TextBlock Grid.Row="4" Text="MAC address" VerticalAlignment="Center"/><TextBox x:Name="MacBox" Grid.Row="4" Grid.Column="1"/>
  <TextBlock Grid.Row="5" Text="Serial number" VerticalAlignment="Center"/><TextBox x:Name="SerialBox" Grid.Row="5" Grid.Column="1"/>
  <TextBlock Grid.Row="6" Text="Vendor" VerticalAlignment="Center"/><TextBox x:Name="VendorBox" Grid.Row="6" Grid.Column="1"/>
  <TextBlock Grid.Row="7" Text="Model" VerticalAlignment="Center"/><TextBox x:Name="ModelBox" Grid.Row="7" Grid.Column="1"/>
  <TextBlock Grid.Row="8" Text="Description" VerticalAlignment="Center"/><TextBox x:Name="DescriptionBox" Grid.Row="8" Grid.Column="1"/>
  <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Save" IsDefault="True" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
