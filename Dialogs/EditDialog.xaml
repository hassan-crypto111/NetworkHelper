<Window x:Class="NetworkHelper.Dialogs.EditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PanelBrush}">
  <StackPanel Margin="18" MinWidth="340"><TextBlock x:Name="NameLabel" Text="Name"/><TextBox x:Name="NameBox"/><TextBlock x:Name="AddressLabel" Text="Address / notes" Margin="3,8,3,0"/><TextBox x:Name="AddressBox"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Save" IsDefault="True" Click="Save_Click"/></StackPanel></StackPanel>
</Window>
