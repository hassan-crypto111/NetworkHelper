<Window x:Class="NetworkHelper.Dialogs.CommandDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Command memory" Width="650" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="Platform" VerticalAlignment="Center"/><TextBox x:Name="PlatformBox" Grid.Column="1"/>
  <TextBlock Grid.Row="1" Text="Category" VerticalAlignment="Center"/><TextBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1"/>
  <TextBlock Grid.Row="2" Text="Command" VerticalAlignment="Center"/><TextBox x:Name="CommandBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/>
  <TextBlock Grid.Row="3" Text="Used for" VerticalAlignment="Center"/><TextBox x:Name="PurposeBox" Grid.Row="3" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/>
  <TextBlock Grid.Row="4" Text="Safety" VerticalAlignment="Center"/><ComboBox x:Name="RiskBox" Grid.Row="4" Grid.Column="1"/>
  <TextBlock Grid.Row="5" Text="Notes" VerticalAlignment="Center"/><TextBox x:Name="NotesBox" Grid.Row="5" Grid.Column="1"/>
  <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True"/><Button Content="Save command" IsDefault="True" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
